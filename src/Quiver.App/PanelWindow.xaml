<Window x:Class="Quiver.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quiver.App.Views"
        Title="Quiver"
        Width="1200"
        Height="760"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <views:PanelView x:Name="View" />
</Window>
