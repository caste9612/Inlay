<Window x:Class="Quiver.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quiver.App.Views"
        Style="{StaticResource Brace.Window}"
        Title="Impostazioni · Quiver"
        Width="960"
        Height="650"
        Background="{DynamicResource Brace.SurfaceBase}"
        Icon="Assets/quiver.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Not resizable: GlazeWM leaves such windows floating, centered, instead of tiling them.
         Its title bar is that of the view, as in the window of Quiver: the band at the top moves it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <views:SettingsView x:Name="View" />
</Window>
