<Window x:Class="Quiver.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quiver.App.Views"
        Style="{StaticResource Brace.Window}"
        Title="Impostazioni · Quiver"
        Width="960"
        Height="650"
        Background="{DynamicResource Brace.SurfaceBase}"
        Icon="Assets/quiver.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Not resizable: GlazeWM leaves such windows floating, centered, instead of tiling them. -->
    <views:SettingsView x:Name="View" />
</Window>
