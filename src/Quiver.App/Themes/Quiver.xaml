<!-- What Quiver adds to Brace: its logo, the buttons of its title bars, and the icon to restore a maximized window, which
     Brace does not have yet. Everything else comes from Brace (Brace\Brace.xaml). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Restore: two squares, the front one as Brace.Icon.Maximize16 draws its square (1 px, rounded corners), the back one
         showing above and to the right of it. To be moved into Brace, so that every app uses the same. -->
    <StreamGeometry x:Key="Quiver.Icon.Restore16">F1 M 5 5 V 4.5 C 5 3.67 5.67 3 6.5 3 H 11.5 C 12.33 3 13 3.67 13 4.5 V 9.5 C 13 10.33 12.33 11 11.5 11 H 11 V 10 H 11.5 A .5 .5 0 0 0 12 9.5 V 4.5 A .5 .5 0 0 0 11.5 4 H 6.5 A .5 .5 0 0 0 6 4.5 V 5 Z M 4.5 5 C 3.67 5 3 5.67 3 6.5 V 11.5 C 3 12.33 3.67 13 4.5 13 H 9.5 C 10.33 13 11 12.33 11 11.5 V 6.5 C 11 5.67 10.33 5 9.5 5 Z M 4.5 6 H 9.5 A .5 .5 0 0 1 10 6.5 V 11.5 A .5 .5 0 0 1 9.5 12 H 4.5 A .5 .5 0 0 1 4 11.5 V 6.5 A .5 .5 0 0 1 4.5 6 Z</StreamGeometry>

    <!-- The title bar of a window drawn by Quiver, as br-titlebar of Brace: titlebar-height, surface-base, and a border that
         sets it apart from the panels below. Where nothing takes the click, the frame of the window moves it. -->
    <Style x:Key="Quiver.TitleBar" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Brace.TitlebarHeight}" />
        <!-- space-sm on the left only: the buttons of the window reach the right edge, as tall as the bar. -->
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource Brace.SurfaceBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brace.BorderDefault}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- The buttons of the window, as br-titlebar-btn: 46 px wide, as tall as the bar, text-secondary; surface-hover under the
         pointer. Not reached with Tab, as those of Windows: Esc, Alt+Space and the shortcut do it from the keyboard. -->
    <Style x:Key="Quiver.TitleBarButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brace.TextSecondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brace.SurfaceHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brace.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brace.SurfaceActive}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Close, as br-titlebar-btn-close: danger under the pointer, with the icon in text-on-accent. -->
    <Style x:Key="Quiver.TitleBarCloseButton" TargetType="ButtonBase" BasedOn="{StaticResource Quiver.TitleBarButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brace.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brace.TextOnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The pin, as in Pulse: a tool of the bar (Brace.IconButton, control-sm) that, checked, keeps the window above the
         others. As every active tool in Brace it shows on accent-subtle with the icon in accent; the icon stays the regular one. -->
    <Style x:Key="Quiver.PinButton" TargetType="ToggleButton" BasedOn="{StaticResource Brace.IconButton.Small}">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="ToolTip" Value="Sempre in primo piano: disattivato" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="Sempre in primo piano: attivo" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The archive in use, as the badge of the project in br-titlebar: a plain badge, since the bar keeps its one amber
         for the pin. A click opens the archives. -->
    <Style x:Key="Quiver.ProjectBadge" TargetType="Button">
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brace.SurfaceActive}" />
        <Setter Property="Foreground" Value="{DynamicResource Brace.TextSecondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Brace.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Brace.RadiusXs}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brace.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brace.SurfaceHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Maximize, or restore when the window is maximized. -->
    <Style x:Key="Quiver.MaximizeButton" TargetType="Button" BasedOn="{StaticResource Quiver.TitleBarButton}">
        <Setter Property="ToolTip" Value="Ingrandisci" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="ToolTip" Value="Ripristina" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Quiver.MaximizeIcon" TargetType="Path" BasedOn="{StaticResource Brace.Icon}">
        <Setter Property="Data" Value="{StaticResource Brace.Icon.Maximize16}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Data" Value="{StaticResource Quiver.Icon.Restore16}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The board: a tall tile and two square ones, the amber one selected (same drawing as Assets\quiver.ico). -->
    <DrawingImage x:Key="Quiver.Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#313741">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2,2,124,124" RadiusX="28" RadiusY="28" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#1B1F24">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4,4,120,120" RadiusX="26" RadiusY="26" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#333943">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="24,24,38,80" RadiusX="8" RadiusY="8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFA133">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="68,24,36,36" RadiusX="8" RadiusY="8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#333943">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="68,68,36,36" RadiusX="8" RadiusY="8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
