<Window x:Class="Quiver.App.ArchivesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quiver.App.Views"
        Style="{StaticResource Brace.Window}"
        Title="Archivi · Quiver"
        Width="880"
        Height="650"
        Background="{DynamicResource Brace.SurfaceBase}"
        Icon="Assets/quiver.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Not resizable: GlazeWM leaves such windows floating, centered, instead of tiling them. -->
    <views:ArchivesView x:Name="View" />
</Window>
