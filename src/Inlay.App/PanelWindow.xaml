<Window x:Class="Inlay.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Inlay.App.Views"
        Style="{StaticResource Brace.Window}"
        Title="Inlay"
        Width="1200"
        Height="760"
        MinWidth="640"
        MinHeight="420"
        Background="{DynamicResource Brace.SurfaceBase}"
        Icon="Assets/inlay.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual">
    <!-- No title bar of Windows: the top band of the view is Inlay's own, as br-titlebar of Brace. Where nothing takes the
         click it moves the window, a double click maximizes it, and Windows still snaps it to the edges. The frame of Windows
         stays, invisible, for resizing from the edges, for the shadow and the corners; no glass, as in Pulse, since every
         pixel of it costs drawing. CaptionHeight is the height of that band, titlebar-height. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <views:PanelView x:Name="View" />
</Window>
