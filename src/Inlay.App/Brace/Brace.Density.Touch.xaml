<!-- Brace, densità touch per WPF. GENERATO da strumenti/genera_piattaforme.py: non modificarlo a mano.
     Uniscilo dopo Brace.Tokens.xaml, nell'app o in una sua parte, per passare ai controlli da 44 px. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <sys:Double x:Key="Brace.ControlHeight">44</sys:Double>
  <sys:Double x:Key="Brace.RowHeight">44</sys:Double>
  <sys:Double x:Key="Brace.IconSize">20</sys:Double>
  <sys:Double x:Key="Brace.TextSize">15</sys:Double>
  <sys:Double x:Key="Brace.ButtonTextSize">14</sys:Double>
  <sys:Double x:Key="Brace.ButtonPaddingX">16</sys:Double>
</ResourceDictionary>
